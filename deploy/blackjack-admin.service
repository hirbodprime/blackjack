[Unit]
Description=Blackjack Django Administration
After=network.target

[Service]
Type=simple
User=blackjackbot
Group=blackjackbot
WorkingDirectory=/opt/blackjackbot
EnvironmentFile=/etc/blackjackbot.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/blackjackbot/.venv/bin/gunicorn blackjack.wsgi:application --bind 127.0.0.1:8010 --workers 1 --threads 2 --timeout 60 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/blackjackbot

[Install]
WantedBy=multi-user.target
