[Unit]
Description=Blackjack Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blackjackbot
Group=blackjackbot
WorkingDirectory=/opt/blackjackbot
EnvironmentFile=/etc/blackjackbot.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/blackjackbot/.venv/bin/python /opt/blackjackbot/blackjack.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/blackjackbot

[Install]
WantedBy=multi-user.target
